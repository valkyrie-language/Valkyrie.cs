<widget>
    <div class="ys-sidebar">
        <div class="ys-sidebar-header">
            <h3>仓库</h3>
        </div>
        <div class="ys-repo-list">
            {#each repos as repo}
                <div class="ys-repo-item {repo.active ? 'active' : ''}" on:click={selectRepo(repo.id)}>
                    <span class="ys-repo-icon">📦</span>
                    <div class="ys-repo-info">
                        <span class="ys-repo-name">{repo.name}</span>
                        <span class="ys-repo-desc">{repo.description}</span>
                    </div>
                </div>
            {/each}
        </div>
        <div class="ys-sidebar-footer">
            <button class="ys-btn ys-btn-sm" on:click={addRepo}>+ 新建仓库</button>
        </div>
    </div>
</widget>

<script>
    let repos: Array = __voa_state("repos")

    macro selectRepo(id: string) { __voa_call("select_repo", id) }
    macro addRepo() { __voa_call("add_repo") }
</script>

<style>
.ys-sidebar {
    width: 260px;
    min-width: 260px;
    border-right: 1px solid var(--ys-border);
    display: flex;
    flex-direction: column;
    background: var(--ys-sidebar-bg);
    height: 100vh;
}

.ys-sidebar-header {
    padding: 16px;
    border-bottom: 1px solid var(--ys-border);
}

.ys-sidebar-header h3 {
    font-size: 13px;
    font-weight: 600;
    color: var(--ys-text2);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0;
}

.ys-repo-list {
    flex: 1;
    overflow-y: auto;
    padding: 8px;
}

.ys-repo-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s;
}

.ys-repo-item:hover {
    background: var(--ys-hover);
}

.ys-repo-item.active {
    background: var(--ys-active);
}

.ys-repo-icon {
    font-size: 18px;
}

.ys-repo-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.ys-repo-name {
    font-size: 13px;
    font-weight: 500;
    color: var(--ys-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ys-repo-desc {
    font-size: 11px;
    color: var(--ys-text3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ys-sidebar-footer {
    padding: 12px;
    border-top: 1px solid var(--ys-border);
}
</style>
