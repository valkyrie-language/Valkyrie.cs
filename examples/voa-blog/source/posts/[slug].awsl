<widget>
    <div class="blog-post">
        <article>
            <header class="post-header">
                <div class="post-meta">
                    <span class="post-date">{post.date}</span>
                    <span class="post-reading-time">{post.reading_time} 分钟阅读</span>
                </div>
                <h1 class="post-title">{post.title}</h1>
                <div class="post-author">by {post.author}</div>
                <div class="post-tags">
                    <for each={post.tags}>
                        <Badge variant="primary" size="small">{tag}</Badge>
                    </for>
                </div>
            </header>

            <div class="post-content">
                {post.content}
            </div>
        </article>

        <section class="post-comments">
            <h2 class="comments-title">评论（{length(comments)}）</h2>

            <for each={comments}>
                <div class="comment">
                    <div class="comment-avatar">
                        <Avatar name={comment.author} size="small" />
                    </div>
                    <div class="comment-body">
                        <div class="comment-header">
                            <span class="comment-author">{comment.author}</span>
                            <span class="comment-date">{comment.date}</span>
                        </div>
                        <p class="comment-content">{comment.content}</p>
                    </div>
                </div>
            </for>

            <div class="comment-form">
                <h3 class="comment-form-title">发表评论</h3>
                <Input label="昵称" placeholder="你的名字" value={newCommentAuthor} on:input={(e) => { newCommentAuthor = e.value }} />
                <div class="comment-form-field">
                    <label class="comment-form-label">评论内容</label>
                    <textarea
                        class="comment-textarea"
                        placeholder="写下你的想法..."
                        value={newCommentContent}
                        on:input={(e) => { newCommentContent = e.value }}
                    />
                </div>
                <Button variant="primary" label="提交评论" on:click={submitComment} />
            </div>
        </section>

        <div class="post-nav">
            <Link href="/posts">← 返回文章列表</Link>
        </div>
    </div>
</widget>

<script>
    let slug = use_params()["slug"] || ""
    let post = get_post_by_slug(slug)
    let comments = get_comments(slug)
    let newCommentAuthor: string = ""
    let newCommentContent: string = ""

    micro submitComment() {
        if newCommentAuthor != "" && newCommentContent != "" {
            add_comment(slug, newCommentAuthor, newCommentContent)
            comments = get_comments(slug)
            newCommentAuthor = ""
            newCommentContent = ""
        }
    }
</script>

<style>
.blog-post { padding: 20px 0; }
.post-header { margin-bottom: 32px; }
.post-meta {
    display: flex;
    gap: 12px;
    font-size: 13px;
    color: var(--voa-text-tertiary);
    margin-bottom: 12px;
}
.post-title {
    margin: 0 0 12px;
    font-size: 32px;
    font-weight: 800;
    line-height: 1.3;
}
.post-author {
    font-size: 14px;
    color: var(--voa-text-secondary);
    margin-bottom: 12px;
}
.post-tags { display: flex; gap: 6px; }
.post-content {
    font-size: 16px;
    line-height: 1.8;
    color: var(--voa-text-secondary);
}
.post-comments {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--voa-border);
}
.comments-title {
    margin: 0 0 20px;
    font-size: 20px;
    font-weight: 700;
}
.comment {
    display: flex;
    gap: 12px;
    padding: 16px 0;
    border-bottom: 1px solid var(--voa-border);
}
.comment-body { flex: 1; }
.comment-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
}
.comment-author { font-weight: 600; font-size: 14px; }
.comment-date { font-size: 12px; color: var(--voa-text-tertiary); }
.comment-content { margin: 0; font-size: 14px; color: var(--voa-text-secondary); line-height: 1.6; }
.comment-form { margin-top: 24px; }
.comment-form-title { margin: 0 0 16px; font-size: 16px; font-weight: 600; }
.comment-form-field { margin-bottom: 12px; }
.comment-form-label { display: block; font-size: 14px; font-weight: 500; margin-bottom: 6px; }
.comment-textarea {
    width: 100%;
    min-height: 100px;
    padding: 10px 12px;
    border: 1px solid var(--voa-border);
    border-radius: var(--voa-radius-md);
    background: var(--voa-card);
    color: var(--voa-text);
    font-size: 14px;
    resize: vertical;
}
.post-nav { margin-top: 32px; }
</style>
