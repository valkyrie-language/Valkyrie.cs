<widget>
    <div class="admin-layout">
        <aside class="admin-sidebar">
            <div class="admin-sidebar-header">
                <h2 class="admin-logo">VOA Admin</h2>
            </div>
            <nav class="admin-nav">
                <Link href="/dashboard" class="admin-nav-item">📊 仪表盘</Link>
                <Link href="/users" class="admin-nav-item">👥 用户管理</Link>
                <Link href="/settings" class="admin-nav-item">⚙️ 设置</Link>
            </nav>
            <div class="admin-sidebar-footer">
                <div class="admin-user-info">
                    <Avatar name="A" size="small" />
                    <span>admin</span>
                </div>
                <Button variant="ghost" size="small" label="退出" on:click={handleLogout} />
            </div>
        </aside>

        <div class="admin-main-area">
            <header class="admin-topbar">
                <h1 class="admin-page-title">{pageTitle}</h1>
                <div class="admin-topbar-right">
                    <Badge variant="success" dot={true} />
                    <span style="font-size:13px; color: var(--voa-text-secondary)">在线</span>
                </div>
            </header>
            <main class="admin-content">
                <slot />
            </main>
        </div>
    </div>
</widget>

<script>
    let pageTitle: string = "仪表盘"

    micro handleLogout() {
        logout()
        __voa_navigate__("/login", true)
    }
</script>

