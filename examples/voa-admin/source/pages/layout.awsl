    font-size: 14px;
    transition: all var(--voa-transition-fast);
}
.admin-nav-item:hover { background: var(--voa-hover); color: var(--voa-text); }
.admin-nav-item.active { background: var(--voa-accent-subtle); color: var(--voa-accent); }
.admin-sidebar-footer {
    padding: 12px 16px;
    border-top: 1px solid var(--voa-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
}
